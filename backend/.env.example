# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database Configuration
DATABASE_PATH=./src/config/finance.sqlite

# ==============================================================================
# IBM Watson Assistant V2 Configuration
# ==============================================================================
# 1. Sign up or log in to IBM Cloud: https://cloud.ibm.com/
# 2. In Catalog, search for "Watson Assistant" and create a free Lite instance.
# 3. In the Watson Assistant resource page, click "Manage" or "Service Credentials":
#    - Copy "API Key" into WATSON_ASSISTANT_APIKEY below.
#    - Copy "URL" into WATSON_ASSISTANT_URL below.
# 4. Open the Watson Assistant tool:
#    - Navigate to Assistant Settings -> Environments tab (Draft or Live).
#    - Copy the "Environment ID" (or Assistant ID) into WATSON_ASSISTANT_ID below.
# 5. (Optional) Upload the pre-configured Skill JSON located at:
#    backend/watson/watson_assistant_skill.json
# ==============================================================================
WATSON_ASSISTANT_APIKEY=
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=
WATSON_ASSISTANT_VERSION=2021-11-27
